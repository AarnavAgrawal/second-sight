# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_AGENT=claude-sonnet-5-5
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
DEEPGRAM_TTS_VOICE_SOUTH=aura-2-orion-en
# Local actors (WSL: scripts/actor-dev.sh):
TERSE_ACTOR_URL=http://127.0.0.1:7100/v1/projects/local/actors
